{
  "name": "chess-repertoire",
  "version": "1.1.0",
  "description": "A chess repertoire helper, PGN viewer/editor and opening trainer for Obsidian.",
  "keywords": [
    "chess",
    "obsidian"
  ],
  "license": "GPL-3.0-or-later",
  "author": "moise-dev",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "format": "prettier --write .",
    "prepare": "husky install",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "deploy": "npm run build && node deploy.mjs",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/*.test.js"
  },
  "dependencies": {
    "@tiptap/pm": "2.0.3",
    "@tiptap/react": "2.0.3",
    "@tiptap/starter-kit": "2.0.3",
    "chess.js": "1.0.0-beta.6",
    "chessground": "8.3.7",
    "immer": "^10.0.2",
    "lucide-react": "0.220.0",
    "nanoid": "4.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "20.2.1",
    "@types/react": "18.2.6",
    "@types/react-dom": "18.2.4",
    "@typescript-eslint/eslint-plugin": "5.59.6",
    "@typescript-eslint/parser": "5.59.6",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.19",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "husky": "8.0.3",
    "obsidian": "latest",
    "prettier": "2.8.8",
    "prettier-plugin-organize-imports": "3.2.2",
    "pretty-quick": "3.1.3",
    "tslib": "2.5.2",
    "typescript": "5.0.4"
  }
}
