{
  "name": "chess-repertoire",
  "version": "1.4.0",
  "description": "A chess repertoire helper, PGN viewer/editor and opening trainer for Obsidian.",
  "keywords": [
    "chess",
    "obsidian"
  ],
  "license": "GPL-3.0-or-later",
  "author": "moise-dev",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "format": "prettier --write .",
    "prepare": "husky install",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "deploy": "npm run build && node deploy.mjs",
    "test": "esbuild tests/*.test.ts --bundle --alias:obsidian=./tests/stubs/obsidian.ts --external:jsdom --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/*.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "chess.js": "1.0.0-beta.6",
    "chessground": "8.3.7",
    "immer": "^10.0.2",
    "lucide-react": "0.220.0",
    "nanoid": "^5.1.16",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "20.2.1",
    "@types/react": "18.2.6",
    "@types/react-dom": "18.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "8.0.3",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "prettier": "2.8.8",
    "prettier-plugin-organize-imports": "3.2.2",
    "pretty-quick": "3.1.3",
    "tslib": "2.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
