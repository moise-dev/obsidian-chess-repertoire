{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"jsx": "react",
		"lib": ["DOM", "DOM.Iterable", "ES2021"]
	},
	"include": ["**/*.ts", "src/**/*.tsx"],
	"exclude": ["node-modules"]
}
